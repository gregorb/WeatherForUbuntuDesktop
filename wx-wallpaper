class Fonts:
    def __init__(self, s):
        self.big = ImageFont.truetype(f"{UBUNTU}/Ubuntu-Th.ttf", int(205 * s))
        self.cond = ImageFont.truetype(f"{UBUNTU}/Ubuntu-M.ttf", int(42 * s))
        self.label = ImageFont.truetype(f"{UBUNTU}/Ubuntu-M.ttf", int(31 * s))
        self.body = ImageFont.truetype(f"{UBUNTU}/Ubuntu-R.ttf", int(29 * s))
        self.small = ImageFont.truetype(f"{UBUNTU}/Ubuntu-M.ttf", int(28 * s))
        self.tiny = ImageFont.truetype(f"{UBUNTU}/Ubuntu-R.ttf", int(21 * s))
        self.icon_s = ImageFont.truetype(FA, int(26 * s))
        self.icon_xl = ImageFont.truetype(FA, int(96 * s))


def grad(size, top, bottom):
    """Vertical alpha gradient, RGBA."""
    w, h = size
    strip = Image.new("L", (1, h))
    px = strip.load()
    for y in range(h):
        f = y / max(h - 1, 1)
        px[0, y] = int(top + (bottom - top) * f)
    return strip.resize((w, h))


def tint(base, rgb, strength):
    w, h = base.size
    overlay = Image.new("RGBA", (w, h), rgb + (0,))
    overlay.putalpha(grad((w, h), int(strength * 1.35), int(strength * 0.35)))
    base.alpha_composite(overlay)


def rounded(draw, box, radius, fill=None, outline=None, width=1):
    draw.rounded_rectangle(box, radius=radius, fill=fill, outline=outline, width=width)


def precip_text(value, kind):
    """Open-Meteo reports a probability, ARSO reports millimetres fallen."""
    if kind == "mm":
        return f"{value:.1f}".rstrip("0").rstrip(".") + "mm"
    return f"{round(value)}%"


def soft_alpha(a, bright=240):
    """Alpha for a faint text run: lifted halfway toward the bright text, which
    starts at 240, without ever reaching it. Fainter runs therefore gain more
    than louder ones, and the hierarchy inside the panel survives."""
    return a if a >= bright else int(a + (bright - a) * 0.5)


def footer_text(data, now, stale=False):
    """Left footer. Says 'cached' when the numbers are the last good reading and
    'stale' once they are too old to describe right now, so an outdated panel
    cannot be mistaken for a freshly fetched one."""
    cached_at = data.get("_cached")
    provider = str(data.get("provider") or "")
    text = (f"updated {cached_at} · {'stale' if stale else 'cached'}" if cached_at
            else f"updated {now:%H:%M}")
    return text + (f"  ·  {provider}" if provider else "")


def precip_frac(value, kind):
    """Bar fill: probability over 100%, millimetres over a wet 4 mm hour."""
    if kind == "mm":
        return min(1.0, max(0.0, value / 4.0))
    return min(1.0, max(0.0, value / 100.0))


def dir_arrow(size, deg, color):
    """Small arrow pointing the way the wind blows *to*."""
    s = size
    img = Image.new("RGBA", (s, s), (0, 0, 0, 0))
    d = ImageDraw.Draw(img)
    c = s / 2
    r = s * 0.40
    # up = north
    pts = [(c, c - r), (c - r * 0.52, c + r * 0.72), (c, c + r * 0.34),
           (c + r * 0.52, c + r * 0.72)]
    d.polygon(pts, fill=color)
    return img.rotate(deg, resample=Image.Resampling.BICUBIC, expand=False)


def sparkline(img, fonts, xy, w, h, hours, temps, line_col, text_col):
    if len(temps) < 2:
        return
    d = ImageDraw.Draw(img, "RGBA")
    x0, y0 = xy
    lo, hi = min(temps), max(temps)
    span = (hi - lo) or 1.0
    pad = h * 0.18
    pts = []
    for i, t in enumerate(temps):
        px = x0 + w * i / (len(temps) - 1)
        py = y0 + h - pad - (h - 2 * pad) * (t - lo) / span
        pts.append((px, py))

    # area under the curve
    area = Image.new("RGBA", img.size, (0, 0, 0, 0))
    ad = ImageDraw.Draw(area)
    ad.polygon(pts + [(pts[-1][0], y0 + h), (pts[0][0], y0 + h)],
               fill=line_col[:3] + (48,))
    img.alpha_composite(area)

    d.line(pts, fill=line_col, width=3, joint="curve")
    for i, (px, py) in enumerate(pts):
        d.ellipse([px - 3.5, py - 3.5, px + 3.5, py + 3.5], fill=line_col)
        if i % 3 == 0 or i == len(pts) - 1:
            d.text((px, y0 - 6), f"{round(temps[i])}", font=fonts.tiny,
                   fill=text_col, anchor="ms")
    for i in range(0, len(hours), 3):
        px = x0 + w * i / (len(temps) - 1)
        d.text((px, y0 + h + 6), hours[i], font=fonts.tiny,
               fill=text_col[:3] + (int(text_col[3] * 0.75),), anchor="ma")


def render(data, cfg, label, w, h, dark):
    """Compose the weather HUD on top of the normal desktop wallpaper."""
    base_path = cfg["base_dark"] if dark else cfg["base_light"]
    try:
        base = Image.open(base_path).convert("RGBA").resize((w, h), Image.Resampling.LANCZOS)
    except Exception as exc:
        log(f"base wallpaper {base_path} unavailable ({exc}); using flat fill")
        base = Image.new("RGBA", (w, h), (24, 28, 38, 255) if dark else (228, 232, 238, 255))

    cur = data["current"]
    code = int(cur["weather_code"])
    cond_name, icon_key, tint_rgb = WMO.get(code, ("Unknown", "cloud", (170, 175, 185)))
    is_day = bool(cur.get("is_day", 1))
    if icon_key == "sun" and not is_day:
        icon_key = "moon"

    sky = NIGHT_TINT if not is_day else tint_rgb
    tint(base, sky, 30 if dark else 22)
    if not is_day:
        base.alpha_composite(Image.new("RGBA", (w, h), (4, 6, 18, 26)))

    fg = (247, 249, 253) if dark else (16, 20, 28)
    fg2 = tuple(int(c * 0.60 + (255 - c) * 0.40) for c in fg)
    panel_fill = (12, 16, 24, 152) if dark else (250, 251, 253, 182)
    hairline = (255, 255, 255, 36) if dark else (20, 24, 32, 30)
    accent = (150, 170, 230) if not is_day else tuple(sky)

    imperial = cfg["units"] == "imperial"
    deg = "°F" if imperial else "°"
    wunit = "mph" if imperial else "km/h"
    now = datetime.now().astimezone()
    # A cached reading older than the limit cannot describe right now. The big
    # number, the condition, the wind and the instant chips are dropped rather
    # than shown wrongly; daily highs/lows age slowly enough to keep.
    stale = int(data.get("_age_min") or 0) > int(cfg.get("stale_after_min", 60))

    # ---------------------------------------------------------------- content
    hh = data.get("hourly", {})
    daily = data.get("daily", {})
    try:
        idx = next(i for i, t in enumerate(hh["time"])
                   if t[:13] == cur["time"][:13])
    except (StopIteration, KeyError, TypeError):
        idx = 0
    probs = hh.get("precip") or hh.get("precipitation_probability") or []
    pkind = hh.get("precip_kind", "prob")

    def precip_at(i):
        try:
            return float(probs[i] or 0) if i < len(probs) and probs[i] is not None else 0.0
        except (TypeError, ValueError):
            return 0.0


    place_line = f"{label}   {now:%a %H:%M}"
    cond_disp = "" if stale else cond_name
    temp_str = "" if stale else f"{round(cur['temperature_2m'])}{deg}"
    # the slot stays measured on a representative digit so an empty one keeps
    # exactly the space a filled one had; only the glyphs are withheld
    temp_m = temp_str or f"0{deg}"
    wind_txt = ("" if stale else
                f"{round(cur['wind_speed_10m'])} {wunit} "
                f"{COMPASS[int((cur['wind_direction_10m'] + 11.25) // 22.5) % 16]}")
    chips = []
    if not stale:                      # instant readings: meaningless once stale
        chips.append(("drop", f"{round(cur['relative_humidity_2m'])}%"))
        feels = cur.get("apparent_temperature")
        if feels is not None:
            chips.append(("therm", f"{round(float(feels))}{deg}"))
    try:                               # daily extremes age slowly enough to keep
        chips.append(("sunrise", f"{round(daily['temperature_2m_max'][0])}{deg}"))
        chips.append(("sunset", f"{round(daily['temperature_2m_min'][0])}{deg}"))
    except (KeyError, IndexError, TypeError):
        pass
    if not stale:
        chips.append(("umbrella", precip_text(precip_at(idx), pkind)))

    temps, hours = [], []
    hp = hh.get("temperature_2m") or []
    ht = hh.get("time") or []
    for i in range(idx, min(idx + 12, len(hp))):
        try:
            temps.append(float(hp[i]))
            hours.append(ht[i][11:16])
        except (TypeError, ValueError, IndexError):
            break

    # hour-by-hour: (label, icon, temperature, chance of precip)
    codes = hh.get("weather_code") or []
    try:
        dawn = int(daily["sunrise"][0][11:13])
        dusk = int(daily["sunset"][0][11:13])
    except (KeyError, IndexError, TypeError, ValueError):
        dawn, dusk = 6, 18
    cols = []
    for i in range(idx, min(idx + 12, len(hp))):
        try:
            value = float(hp[i])
        except (TypeError, ValueError, IndexError):
            break
        hour = int(ht[i][11:13]) if i < len(ht) else now.hour
        wcode = codes[i] if i < len(codes) and codes[i] is not None else code
        try:
            ik = WMO.get(int(wcode), ("", "cloud", None))[1]
        except (TypeError, ValueError):
            ik = "cloud"
        if ik == "sun" and not dawn <= hour < dusk:
            ik = "moon"
        pval = precip_at(i)
        stamp = ht[i] if i < len(ht) else ""
        try:
            behind = (now.replace(tzinfo=None) - datetime.strptime(stamp, "%Y-%m-%dT%H:%M")
                      > timedelta(minutes=int(cfg.get("stale_after_min", 60))))
        except (TypeError, ValueError):
            behind = False
        # live feeds start at the current hour, so only a stale reading can
        # carry cells the clock has left behind
        cols.append((ht[i][11:16] if i < len(ht) else f"{hour:02d}", ik,
                     f"{round(value)}{deg}", precip_text(pval, pkind), pval, pkind,
                     bool(behind and stale)))

    foot_l = footer_text(data, now, stale)
    foot_r = ""
    try:
        foot_r = (f"sunrise {daily['sunrise'][0][11:16]}   "
                  f"sunset {daily['sunset'][0][11:16]}")
    except (KeyError, IndexError, TypeError):
        pass

    # --------------------------------------------- measure, then size the panel
    mx = int(cfg["margin_x_frac"] * w)
    my = int(cfg["margin_y_frac"] * h)
    s = cfg["panel_scale"] * (min(w, h) / 1080.0)
    hourly = cfg.get("hourly", "strip")
    width_frac = max(1.0, float(cfg.get("width_frac", 1.0)))
    probe = ImageDraw.Draw(Image.new("RGBA", (8, 8)))

    def layout(s):
        f = Fonts(s)
        inner = int(30 * s)
        gap_a = int(20 * s)
        gap_b = int(24 * s)
        gap_c = int(20 * s)
        spark_h = int(58 * s)
        tick_h = int(24 * s)
        foot_h = int(24 * s)
        hour_h = int(21 * s)
        icon_h = int(28 * s)
        temp_h = int(31 * s)
        rain_h = int(21 * s)
        bar_h = max(2, int(5 * s))
        strip_h = hour_h + icon_h + temp_h + rain_h + bar_h + int(12 * s)
        cell_w = int(30 * s)
        if cols:
            cell_w = max([cell_w]
                         + [int(12 * s) + int(probe.textlength(c[2], font=f.label))
                            for c in cols]
                         + [int(10 * s) + int(probe.textlength(c[3], font=f.tiny))
                            for c in cols])
        strip_w = cell_w * len(cols)          # narrowest the strip can be; it may
                                              # later be spread across a wider panel

        tw = probe.textlength(temp_m, font=f.big)
        th = f.big.getbbox(temp_m)[3] - f.big.getbbox(temp_m)[1]
        iw = 0 if stale else f.icon_xl.getbbox(ICON[icon_key])[2]
        cw = probe.textlength(cond_disp, font=f.cond)
        ww = 0 if stale else probe.textlength(wind_txt, font=f.body) + int(40 * s)
        pl = probe.textlength(place_line, font=f.small) + int(28 * s)
        fl = probe.textlength(foot_l, font=f.tiny)
        fr = probe.textlength(foot_r, font=f.tiny)

        chip_w = 0
        for key, value in chips:
            chip_w += int(28 * s) + probe.textlength(value, font=f.label) + int(34 * s)
        chip_w = max(0, chip_w - int(34 * s))

        row_left = tw if stale else tw + int(26 * s) + iw + int(34 * s) + max(cw, ww)
        row_a = pl + int(50 * s) + cw            # place line + condition
        use_strip = bool(cols) and hourly == "strip"
        rows_h = strip_h if use_strip else spark_h + tick_h
        body_w = max(pl, row_left, chip_w, fl + int(60 * s) + fr, row_a, strip_w)
        natural_w = body_w + 2 * inner + int(14 * s)
        return dict(f=f, inner=inner, win_w=int(natural_w * width_frac),
                    win_h=inner + int(44 * s) + gap_a + th + gap_b + int(40 * s)
                          + gap_c + rows_h + int(10 * s) + foot_h + inner,
                    th=th, iw=iw, tw=tw, cw=cw, ww=ww, spark_h=spark_h,
                    tick_h=tick_h, foot_h=foot_h, gap_a=gap_a, gap_b=gap_b,
                    gap_c=gap_c, use_strip=use_strip, strip_h=strip_h,
                    cell_w=cell_w, hour_h=hour_h, icon_h=icon_h, temp_h=temp_h,
                    rain_h=rain_h, bar_h=bar_h)

    lay = layout(s)
    for _ in range(6):  # shrink until it comfortably fits the screen
        if lay["win_w"] <= w - 2 * mx and lay["win_h"] <= h - 2 * my:
            break
        s *= 0.88
        lay = layout(s)
    f, inner = lay["f"], lay["inner"]
    if lay["use_strip"] and cols:
        # a panel wider than its content needs spreads the hourly cells evenly
        # rather than leaving dead space on the right
        lay["cell_w"] = max(lay["cell_w"],
                            (lay["win_w"] - 2 * inner - int(10 * s)) / len(cols))

    x0 = {"left": mx, "center": (w - lay["win_w"]) // 2,
          "right": w - mx - lay["win_w"]}.get(cfg.get("anchor_x", "left"), mx)
    y0 = {"top": my, "center": (h - lay["win_h"]) // 2,
          "bottom": h - my - lay["win_h"]}.get(cfg.get("anchor_y", "top"), my)
    x0 = max(0, min(x0, w - lay["win_w"]))          # never hang off the screen
    y0 = max(0, min(y0, h - lay["win_h"]))
    x1, y1 = x0 + lay["win_w"], y0 + lay["win_h"]
    cx = x0 + inner + int(10 * s)
    rx = x1 - inner
    rad = int(30 * s)
    LAST_LAYOUT.clear()
    LAST_LAYOUT.update(x=x0, y=y0, x1=x1, y1=y1, inner=inner, scale=s,
                       width=lay["win_w"], height=lay["win_h"])

    # ---------------------------------------------------------------- the HUD
    # Everything is drawn on one layer so the finished panel can be composited
    # onto the wallpaper at a single uniform opacity. "RGBA" mode makes fills,
    # outlines and antialiased text blend into the layer instead of overwriting
    # its alpha channel.
    opacity = min(1.0, max(0.05, float(cfg.get("hud_opacity", 1.0))))
    # Text is drawn on a layer of its own and composited at a higher opacity than the
    # glass. Damping the letters by the same factor as a half-transparent panel is what
    # made the smaller runs look muddy; this way the faint text becomes readable while
    # the big temperature stays the loudest thing in the panel.
    text_opacity = cfg.get("hud_text_opacity")
    text_opacity = (min(1.0, opacity + (1.0 - opacity) * 0.7) if text_opacity is None
                    else min(1.0, max(0.05, float(text_opacity))))
    hud = Image.new("RGBA", (w, h), (0, 0, 0, 0))
    d = ImageDraw.Draw(hud, "RGBA")
    ink = Image.new("RGBA", (w, h), (0, 0, 0, 0))
    td = ImageDraw.Draw(ink, "RGBA")
    d.rounded_rectangle([x0, y0, x1, y1], radius=rad, fill=panel_fill)
    d.rounded_rectangle([x0, y0, x1, y1], radius=rad, outline=hairline,
                        width=max(1, int(1.5 * s)))
    d.rounded_rectangle([x0, y0 + int(28 * s), x0 + int(5 * s), y1 - int(28 * s)],
                        radius=int(2.5 * s), fill=accent + (210,))

    y = y0 + inner

    # row A: where + when, condition
    td.text((cx + int(24 * s), y + int(2 * s)), ICON["pin"], font=f.icon_s,
           fill=fg2 + (190,))
    td.text((cx + int(24 * s) + int(22 * s), y), place_line, font=f.small,
           fill=fg2 + (240,))
    td.text((rx, y + int(1 * s)), cond_disp, font=f.cond, fill=fg + (255,), anchor="ra")
    y_a = y                                        # top of the location line
    y += int(44 * s) + lay["gap_a"]

    # row B: big temperature, condition icon, wind.
    # The number is centred on the line exactly halfway between the location text
    # above and the chips below. Centring the digits' own ink box, rather than the
    # font box, is what makes it look centred: a "8°" has no descender, so a
    # metrically centred box would still read as sitting too low.
    y_c = y + lay["th"] + lay["gap_b"]             # top of the chip row
    a_up, a_down = f.small.getmetrics()
    c_up, c_down = f.label.getmetrics()
    mid_y = ((y_a + (a_up + a_down) / 2) + (y_c + (c_up + c_down) / 2)) / 2
    tbb = f.big.getbbox(temp_m)
    y_num = mid_y - (tbb[1] + tbb[3]) / 2
    if temp_str:      # a stale reading leaves the number slot empty, in place
        td.text((cx - int(4 * s), y_num), temp_str, font=f.big, fill=fg + (255,))
    if not stale:      # the current condition and wind are precisely what a
        ix = cx + lay["tw"] + int(26 * s)
        ibb = f.icon_xl.getbbox(ICON[icon_key])          # stale reading can no
        td.text((ix, mid_y - (ibb[1] + ibb[3]) / 2), ICON[icon_key],        # longer
                font=f.icon_xl, fill=accent + (235,))                       # state
        arrow = dir_arrow(int(32 * s), float(cur["wind_direction_10m"]) + 180,
                          fg2 + (215,))
        ax = rx - lay["ww"] + int(6 * s)
        hud.alpha_composite(arrow, (int(ax), int(y + lay["th"] - int(34 * s))))
        td.text((rx, y + lay["th"] - int(30 * s)), wind_txt, font=f.body,
               fill=fg2 + (245,), anchor="ra")
    y += lay["th"] + lay["gap_b"]

    # row C: chips
    x = cx
    for key, value in chips:
        td.text((x, y + int(6 * s)), ICON[key], font=f.icon_s, fill=accent + (215,))
        td.text((x + int(28 * s), y), value, font=f.label, fill=fg + (240,))
        x += int(28 * s) + d.textlength(value, font=f.label) + int(34 * s)
    y += int(40 * s) + lay["gap_c"]

    # row D: the next 12 hours
    if lay["use_strip"]:
        cell = lay["cell_w"]
        half = (cell - int(10 * s)) / 2
        y_icon = y + lay["hour_h"]
        y_temp = y_icon + lay["icon_h"]
        y_rain = y_temp + lay["temp_h"]
        y_bar = y_rain + lay["rain_h"]
        LAST_LAYOUT.update(strip_y=y, strip_h=lay["strip_h"], cell_w=cell,
                           hours=len(cols), strip_x=cx)
        for i, (hlabel, hicon, htemp, ptext, pval, pkind, behind) in enumerate(cols):
            mid = cx + cell * i + cell / 2
            td.text((mid, y), hlabel, font=f.tiny, fill=fg2 + (soft_alpha(215),),
                   anchor="ma")
            if behind:      # this hour has come and gone while the data stood still
                continue
            td.text((mid, y_icon), ICON[hicon], font=f.icon_s, fill=accent + (230,),
                   anchor="ma")
            td.text((mid, y_temp), htemp, font=f.label, fill=fg + (245,), anchor="ma")
            td.text((mid, y_rain), ptext, font=f.tiny,
                   fill=fg2 + (soft_alpha(205 if pval else 105),), anchor="ma")
            if pval:                     # bar: chance of rain, or millimetres fallen
                frac = precip_frac(pval, pkind)
                d.rounded_rectangle([mid - half, y_bar,
                                     mid - half + (cell - int(10 * s)) * frac,
                                     y_bar + lay["bar_h"]],
                                    radius=max(1, lay["bar_h"] // 2),
                                    fill=accent + (min(235, 80 + int(155 * frac)),))
        y += lay["strip_h"] + int(10 * s)
    elif len(temps) >= 3:
        sparkline(hud, f, (cx + int(6 * s), y), x1 - inner - cx - int(12 * s),
                  lay["spark_h"], hours, temps, accent + (235,), fg2 + (225,))
        y += lay["spark_h"] + lay["tick_h"] + int(10 * s)

    fy = y + int(2 * s)
    if stale and "stale" in foot_l:
        # the word "stale" goes on the glass layer in the hairline colour, so it
        # is exactly as faint as the panel outline; the rest of the footer stays
        # on the text layer with the ordinary footer brightness
        pre, post = foot_l.split("stale", 1)
        td.text((cx, fy), pre, font=f.tiny, fill=fg2 + (soft_alpha(160),))
        w1 = d.textlength(pre, font=f.tiny)
        w2 = d.textlength("stale", font=f.tiny)
        # text drawn straight onto the glass layer is pasted, not blended, so
        # the hairline colour would punch translucent white holes in the panel;
        # render the word on its own and alpha-composite it the way dir_arrow
        # does, and it truly shades over the glass like the outline does
        word = Image.new("RGBA", (int(w2) + 4, int(34 * s) + 4), (0, 0, 0, 0))
        ImageDraw.Draw(word).text((0, 0), "stale", font=f.tiny, fill=hairline)
        hud.alpha_composite(word, (int(cx + w1), int(fy)))
        td.text((cx + w1 + w2, fy), post, font=f.tiny, fill=fg2 + (soft_alpha(160),))
        LAST_LAYOUT["footer_stale"] = (cx + w1, cx + w1 + w2, fy)
    else:
        td.text((cx, fy), foot_l, font=f.tiny, fill=fg2 + (soft_alpha(160),))
        LAST_LAYOUT["footer_stale"] = None
    if foot_r:
        td.text((rx, fy), foot_r, font=f.tiny,
               fill=fg2 + (soft_alpha(200),), anchor="ra")

    LAST_LAYOUT.update(opacity=opacity, text_opacity=text_opacity,
                       row_a_c=y_a + (a_up + a_down) / 2, row_c_c=y_c + (c_up + c_down) / 2,
                       temp_c=mid_y, temp_ink=(y_num + tbb[1], y_num + tbb[3]),
                       stale=stale, temp_text=temp_str, chips=[v for _, v in chips],
                       cell_behind=[c[6] for c in cols])

    # drop shadow first, then the whole HUD scaled to the requested visibility
    shadow = Image.new("RGBA", (w, h), (0, 0, 0, 0))
    sd = ImageDraw.Draw(shadow)
    sd.rounded_rectangle([x0 + int(4 * s), y0 + int(10 * s), x1 + int(4 * s),
                          y1 + int(10 * s)], radius=rad,
                         fill=(0, 0, 0, int(120 * opacity)))
    base.alpha_composite(shadow.filter(ImageFilter.GaussianBlur(int(16 * s))))

    if opacity < 1.0:
        hud.putalpha(hud.split()[3].point(lambda a: int(a * opacity)))
    base.alpha_composite(hud)
    if text_opacity < 1.0:
        ink.putalpha(ink.split()[3].point(lambda a: int(a * text_opacity)))
    base.alpha_composite(ink)

    return base


# -------------------------------------------------------------------- main

def unlock_seen(lines):
    """True when this gdbus monitor text announces that the screen was just
    unlocked; a lock is the same signal carrying true instead of false.

    Current gdbus prints the whole signal on one line, '... ActiveChanged
    (false,)'; older builds named the member on the signal line and printed
    the 'boolean false' argument on the line that followed, so watch_unlock
    passes each line joined with the one before it. Only text after the
    signal name counts, so a lock's header followed by an unrelated false
    on the next line cannot read as an unlock.
    """
    at = lines.find("ActiveChanged")
    if at < 0:
        return False
    rest = lines[at:]
    return "boolean false" in rest or "(false" in rest


def unlock_refresh_due(line, cfg, cache_age_s):
    """Whether this line should trigger a refresh: an unlock, the feature
    switched on, and the cached reading old enough that the unlock is not just
    re-rendering what the timer drew a moment ago."""
    if not unlock_seen(line):
        return False
    if not cfg.get("refresh_on_unlock", True):
        return False
    gap = max(0, int(cfg.get("unlock_min_gap", 300)))
    return cache_age_s is None or cache_age_s >= gap


def watch_unlock(cfg):
    """Refresh whenever the desktop is unlocked, until systemd stops us.

    GNOME publishes ActiveChanged on org.gnome.ScreenSaver; ActiveChanged(false)
    means the screen was just unlocked. gdbus comes with the same package as
    gsettings, so this adds no new dependency. Settings are re-read on every
    event, so toggling them needs no restart.
    """
    if not shutil.which("gdbus"):
        log("gdbus not found; cannot watch for unlocks")
        return 1
    proc = subprocess.Popen(
        ["gdbus", "monitor", "--session", "--dest", "org.gnome.ScreenSaver",
         "--object-path", "/org/gnome/ScreenSaver"],
        stdout=subprocess.PIPE, stderr=subprocess.DEVNULL, text=True)

    def stop(_signum, _frame):
        proc.terminate()
        raise SystemExit(0)

    signal.signal(signal.SIGTERM, stop)
    signal.signal(signal.SIGINT, stop)
    log("watching for desktop unlocks")
    prev = ""  # older gdbus split one signal over a header line and an argument line
    try:
        for line in proc.stdout or []:
            if not unlock_seen(prev + line):
                prev = line if "ActiveChanged" in line else ""
                continue
            prev = ""
            live = load_config()
            age = (time.time() - CACHE_FILE.stat().st_mtime) if CACHE_FILE.exists() else None
            if not unlock_refresh_due(line, live, age):
                log("unlocked, but the reading is still fresh")
                continue
            log("desktop unlocked; refreshing")
            subprocess.run([sys.executable, os.path.abspath(__file__)])
    except (BrokenPipeError, KeyboardInterrupt):
        pass
    finally:
        proc.terminate()
    return 0


def main():
    ap = argparse.ArgumentParser(description=__doc__.splitlines()[0])
    ap.add_argument("--dry-run", action="store_true",
                    help="render to a preview file, do not touch the desktop")
    ap.add_argument("--output", help="write the image here instead of the wallpaper dir")
    ap.add_argument("--place", help="city name to look up, e.g. 'Maribor,SI'")
    ap.add_argument("--status", action="store_true")
    ap.add_argument("--watch-unlock", action="store_true",
                    help="keep running and refresh whenever the desktop is unlocked")
    args = ap.parse_args()

    cfg = load_config()
    if args.watch_unlock:
        return watch_unlock(cfg)

    if args.place:
        cfg["place"] = args.place
        cfg["latitude"] = cfg["longitude"] = None
        cfg["place_name"] = None      # a new place needs a freshly derived label

    if args.status:
        ssid = active_ssid(cfg)
        try:                                  # what the last good reading contained
            cached = json.loads(CACHE_FILE.read_text()) if CACHE_FILE.exists() else {}
        except (OSError, ValueError):
            cached = {}
        print(json.dumps({"config": str(CONFIG_FILE),
                          "wifi_network": ssid,
                          "wifi_maps_to": cfg.get("networks", {}).get(ssid) if ssid else None,
                          "providers_tried": cfg.get("providers"),
                          "last_provider": cached.get("provider"),
                          "last_reading_time": (cached.get("current") or {}).get("time"),
                          "config_values": cfg,
                          "cache": str(CACHE_FILE),
                          "cache_age_s": (round(time.time() - CACHE_FILE.stat().st_mtime)
                                          if CACHE_FILE.exists() else None),
                          "renders": [p.name for p in sorted(DATA_DIR.glob("wx-*.png"))],
                          "picture_uri": sh(["gsettings", "get", "org.gnome.desktop.background",
                                             "picture-uri"]).stdout.strip()}, indent=2))
        return 0

    DATA_DIR.mkdir(parents=True, exist_ok=True)
    dark = dark_mode()

    before = json.dumps(cfg, sort_keys=True)
    try:
        lat, lon, label, source = resolve_place(cfg)
        data = fetch_weather_retry(lat, lon, cfg, label)
        CACHE_FILE.write_text(json.dumps(data))
    except Exception as exc:
        log(f"fetch failed: {exc}")
        if CACHE_FILE.exists():
            data = json.loads(CACHE_FILE.read_text())
            lat, lon = data.get("latitude"), data.get("longitude")
            label = cfg.get("place_name") or cfg.get("place") or "Home"
            if isinstance(label, str) and label == "auto":
                label = "Home"
            source = "cached reading"
            stamp = CACHE_FILE.stat().st_mtime
            data["_cached"] = datetime.fromtimestamp(stamp).astimezone().strftime("%H:%M")
            data["_age_min"] = int((time.time() - stamp) / 60)
            log("using last good weather instead")
        else:
            log("no cached weather either; leaving the desktop alone")
            return 1

    if json.dumps(cfg, sort_keys=True) != before:
        save_config(cfg)
        log(f"remembering {label} at ({lat:.3f}, {lon:.3f})")

    w, h = detect_resolution(cfg)
    img = render(data, cfg, label, w, h, dark)

    stamp = datetime.now().astimezone().strftime("%Y%m%d-%H%M%S")
    out = Path(args.output) if args.output else DATA_DIR / f"wx-{stamp}.png"
    out.parent.mkdir(parents=True, exist_ok=True)
    img.convert("RGB").save(out, "PNG", optimize=True)

    if args.dry_run:
        log(f"preview written to {out} ({w}x{h}, {'dark' if dark else 'light'})")
        return 0

    apply_wallpaper(out)
    prune(cfg["keep_files"])
    cur = data["current"]
    provider = data.get("provider", "?")
    log(f"{label} [{source}] via {provider}: {round(cur['temperature_2m'])}° "
        f"{WMO.get(int(cur['weather_code']), ('?',))[0]} -> {out}")
    return 0


if __name__ == "__main__":
    sys.exit(main())
