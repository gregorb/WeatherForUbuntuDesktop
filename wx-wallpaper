def log(msg):
    print(f"[wx-wallpaper] {msg}", file=sys.stderr)


# ----------------------------------------------------------------- config

def load_config():
    cfg = dict(DEFAULTS)
    if CONFIG_FILE.exists():
        try:
            raw = json.loads(CONFIG_FILE.read_text())
            # older configs positioned the panel with a single "corner" key
            if "corner" in raw and "anchor_x" not in raw and "anchor_y" not in raw:
                cfg["anchor_x"] = "right" if raw["corner"].endswith("right") else "left"
                cfg["anchor_y"] = "bottom" if raw["corner"].startswith("bottom") else "top"
            cfg.update(raw)
        except Exception as exc:
            log(f"warning: bad config {CONFIG_FILE}: {exc}")
    return cfg


def save_config(cfg):
    CONFIG_DIR.mkdir(parents=True, exist_ok=True)
    CONFIG_FILE.write_text(json.dumps(cfg, indent=2) + "\n")


def http_json(url, timeout):
    req = urllib.request.Request(url, headers={"User-Agent": "wx-wallpaper/1.0"})
    with urllib.request.urlopen(req, timeout=timeout) as resp:
        return json.loads(resp.read().decode())


def active_ssid(cfg):
    """The Wi-Fi network we are associated with, or None when wired/absent."""
    if not cfg.get("networks"):
        return None                      # nothing configured: don't even ask
    try:
        out = sh(["nmcli", "-t", "-f", "active,ssid", "dev", "wifi"], timeout=5).stdout
        for line in out.splitlines():
            active, _, ssid = line.partition(":")   # SSIDs may contain ':'
            if active.strip() == "yes" and ssid.strip():
                return ssid.strip()
        # association not reported: fall back to the active wireless profile name
        out = sh(["nmcli", "-t", "-f", "NAME,TYPE,DEVICE", "connection",
                  "show", "--active"], timeout=5).stdout
        for line in out.splitlines():
            parts = [f.strip() for f in line.split(":")]
            if len(parts) >= 2 and parts[1] == "802-11-wireless" and parts[0]:
                return parts[0]
    except Exception as exc:
        log(f"wi-fi lookup failed: {exc}")
    return None


def coords_for(name, cfg):
    """Coordinates for a place name, from the geocode cache or the geocoder."""
    cache = cfg.setdefault("place_coords", {})
    hit = cache.get(name)
    if hit:
        return float(hit[0]), float(hit[1])
    q = urllib.parse.urlencode({"name": name, "count": 1, "language": "en",
                                "format": "json"})
    r = http_json(f"https://geocoding-api.open-meteo.com/v1/search?{q}",
                  cfg["timeout"])["results"][0]
    cache[name] = [round(r["latitude"], 4), round(r["longitude"], 4)]
    return r["latitude"], r["longitude"]


def resolve_place(cfg):
    """Decide which place to report weather for.

    A mapped Wi-Fi network wins over the default location. Returns
    (lat, lon, label, source). Anything discovered is recorded back into cfg --
    geocoded coordinates, pinned defaults -- so a later geolocation outage
    cannot leave the wallpaper stale; main() persists cfg.
    """
    ssid = active_ssid(cfg)
    mapped = cfg.get("networks", {}).get(ssid) if ssid else None
    if mapped:
        if isinstance(mapped, dict):
            name = str(mapped.get("name") or ssid)
            if mapped.get("latitude") is not None and mapped.get("longitude") is not None:
                return (float(mapped["latitude"]), float(mapped["longitude"]),
                        name, f"Wi-Fi {ssid}")
        else:
            name = str(mapped)
        try:
            lat, lon = coords_for(name, cfg)
            return lat, lon, name, f"Wi-Fi {ssid}"
        except Exception as exc:
            log(f"no coordinates for '{name}' (mapped from Wi-Fi '{ssid}'): {exc}; "
                "trying the default location")

    if cfg.get("latitude") is not None and cfg.get("longitude") is not None:
        return (float(cfg["latitude"]), float(cfg["longitude"]),
                cfg.get("place_name") or "Home", "default")

    t = cfg["timeout"]
    place = cfg.get("place") or "auto"
    if place != "auto":
        try:
            lat, lon = coords_for(place, cfg)
            label = cfg.get("place_name") or place
            cfg["latitude"], cfg["longitude"] = round(lat, 4), round(lon, 4)
            cfg["place_name"] = label
            return lat, lon, label, "default"
        except Exception as exc:
            log(f"geocoding '{place}' failed ({exc}); falling back to IP")

    lat = lon = None
    label = None
    for svc in ("https://ipapi.co/json/", "https://ipwho.is/"):
        try:
            j = http_json(svc, t)
            if "latitude" in j and j.get("latitude") is not None:
                lat, lon = float(j["latitude"]), float(j["longitude"])
                label = j.get("city") or j.get("region") or None
                break
        except Exception as exc:
            log(f"IP geolocation via {svc} failed: {exc}")
    if lat is None:
        raise RuntimeError("no location: map a Wi-Fi network, or set "
                           f"latitude/longitude or place, in {CONFIG_FILE}")
    label = cfg.get("place_name") or label or "Home"
    cfg["latitude"], cfg["longitude"] = round(lat, 4), round(lon, 4)
    cfg["place_name"] = label
    return lat, lon, label, "public IP"


# ---------------------------------------------------------------- providers

# ARSO (the Slovenian environment agency) runs vreme.si; this is the JSON API the
# site itself calls. It is not documented, so it is the primary source with
# Open-Meteo -- which is documented and global -- behind it as a fallback.
ARSO_SEARCH = "https://www.vreme.si/api/1.0/locations/"
ARSO_LOCATION = "https://www.vreme.si/api/1.0/location/"
ARSO_CLOUD = {"clear": 0, "partCloudy": 1, "prevCloudy": 2, "overcast": 3}
# WMO codes per phenomenon, indexed by intensity (light, moderate, heavy)
ARSO_PHENOM = {
    "DZ": (51, 53, 55), "RA": (61, 63, 65), "SN": (71, 73, 75),
    "FZDZ": (56, 56, 57), "FZRA": (66, 66, 67), "PL": (66, 67, 67),
    "FG": (45, 45, 48), "TS": (95, 95, 96), "GR": (96, 96, 99),
}
ARSO_INTENSITY = {"light": 0, "mod": 1, "moderate": 1, "heavy": 2, "ter": 2}
# ddff_icon carries an English compass point ("lightNE"); dd_shortText is Slovene,
# where S means "sever" (north) -- so prefer the English one.
ARSO_SL_COMPASS = {"S": 0, "SV": 45, "V": 90, "JV": 135, "J": 180,
                   "JZ": 225, "Z": 270, "SZ": 315}
EN_COMPASS = {"N": 0, "NE": 45, "E": 90, "SE": 135, "S": 180,
              "SW": 225, "W": 270, "NW": 315}


def arso_decode(icon):
    """'overcast_lightRA_night' -> (wmo code, is_day); 'lightRA' also occurs."""
    if not icon:
        return None, None
    parts = icon.split("_")
    is_day = None
    if parts and parts[-1] in ("day", "night"):
        is_day = parts[-1] == "day"
        parts = parts[:-1]
    code = None
    for token in parts:
        if token in ARSO_CLOUD:
            code = ARSO_CLOUD[token]
            continue
        m = re.match(r"(light|mod|moderate|heavy|ter)?([A-Z]{2,4})$", token)
        if m and m.group(2) in ARSO_PHENOM:
            code = ARSO_PHENOM[m.group(2)][ARSO_INTENSITY.get(m.group(1), 1)]
    return code, is_day


def arso_direction(row):
    """Wind direction in degrees, preferring the unambiguous English icon."""
    m = re.search(r"([NSEW]{1,2})$", row.get("ddff_icon") or "")
    if m and m.group(1) in EN_COMPASS:
        return float(EN_COMPASS[m.group(1)])
    sl = (row.get("dd_shortText") or "").strip().upper()
    if sl in ARSO_SL_COMPASS:
        return float(ARSO_SL_COMPASS[sl])
    return 0.0


def _arso_queries(place):
    """ARSO matches on a leading fragment of its own title, which is often shorter
    than what the user wrote ('Zagorje' for 'Zagorje ob Savi'). Try whole name,
    then drop trailing words, then try without diacritics."""
    words = [w for w in re.split(r"[,\s]+", place.strip()) if w]
    tries, seen = [], set()

    def add(text):
        key = text.casefold()
        if text and key not in seen:
            seen.add(key)
            tries.append(text)

    for n in range(len(words), 0, -1):
        add(" ".join(words[:n]))
        folded = "".join(c for c in unicodedata.normalize("NFKD", " ".join(words[:n]))
                         if not unicodedata.combining(c))
        add(folded)
    return tries


def arso_title(lat, lon, place, cfg):
    """ARSO's own name for our place, nearest to our coordinates, cached."""
    cache = cfg.setdefault("arso_places", {})
    hit = cache.get(place)
    if hit:
        return hit["title"]
    feats = []
    for query in _arso_queries(place):
        q = urllib.parse.urlencode({"loc": query, "lang": "en"})
        feats = http_json(f"{ARSO_SEARCH}?{q}", cfg["timeout"]).get("features") or []
        if feats:
            break
    if not feats:
        raise RuntimeError(f"no ARSO place matches '{place}' (ARSO covers Slovenia)")

    def away(feat):
        flon, flat = feat["geometry"]["coordinates"]
        return (flat - lat) ** 2 + (flon - lon) ** 2

    best = min(feats, key=away)
    if math.sqrt(away(best)) > 0.35:      # ~35 km: a different town, not ours
        raise RuntimeError(f"nearest ARSO place '{best['properties']['title']}' is "
                           "too far from the configured coordinates")
    flon, flat = best["geometry"]["coordinates"]
    title = best["properties"]["title"]
    cache[place] = {"title": title, "latitude": flat, "longitude": flon}
    return title


def _arso_tz(day):
    """Fixed offset from a day's 'UTCoffset' field, e.g. '+01:00'."""
    raw = (day.get("UTCoffset") or "").strip()
    m = re.match(r"([+-])(\d{2}):?(\d{2})$", raw)
    if not m:
        return None
    delta = timedelta(hours=int(m.group(2)), minutes=int(m.group(3)))
    return timezone(delta if m.group(1) == "+" else -delta)


def _arso_rows(block):
    out = []
    try:
        days = block["features"][0]["properties"]["days"]
    except (KeyError, IndexError, TypeError):
        return out
    for day in days or []:
        for row in day.get("timeline") or []:
            out.append((day, row))
    return out


def _num(value, default=None):
    try:
        return float(value)
    except (TypeError, ValueError):
        return default


def _local(valid, tz):
    """'2026-10-30T19:00:00+00:00' -> 'YYYY-MM-DDTHH:MM' in the place's own zone."""
    try:
        dt = datetime.fromisoformat(valid)
    except (TypeError, ValueError):
        return None
    if tz is not None:
        dt = dt.astimezone(tz)
    return dt.strftime("%Y-%m-%dT%H:%M")


def fetch_arso(lat, lon, cfg, place):
    """ARSO/vreme.si, translated into the same shape Open-Meteo gives us."""
    t = cfg["timeout"]
    title = arso_title(lat, lon, place, cfg)
    q = urllib.parse.urlencode({"lang": "en", "location": title})
    d = http_json(f"{ARSO_LOCATION}?{q}", t)

    obs = _arso_rows(d.get("observation"))
    if not obs:
        raise RuntimeError("ARSO returned no observation")
    day, row = obs[-1]
    tz = _arso_tz(day)
    code, is_day = arso_decode(row.get("clouds_icon_wwsyn_icon") or row.get("wwsyn_icon"))
    if code is None:
        code, is_day = 3, None
    if is_day is None:                     # fall back to the local clock + sun times
        sr, ss = day.get("sunrise"), day.get("sunset")
        hour = (datetime.fromisoformat(row["valid"]).astimezone(tz).hour
                if tz and row.get("valid") else datetime.now().hour)
        try:
            is_day = int(datetime.fromisoformat(sr)[11:13]) <= hour < int(
                datetime.fromisoformat(ss)[11:13])
        except (TypeError, ValueError, IndexError):
            is_day = 6 <= hour < 18

    wind_ms = _num(row.get("ff_val"), 0.0) or 0.0
    imperial = cfg["units"] == "imperial"
    wind = wind_ms * (2.23694 if imperial else 3.6)      # m/s -> mph / km/h

    hourly, acc = [], None
    for hday, hrow in _arso_rows(d.get("forecast1h")):
        stamp = _local(hrow.get("valid"), _arso_tz(hday) or tz)
        temp = _num(hrow.get("t"))
        if not stamp or temp is None:
            continue
        amount = _num(hrow.get("tp_acc"))
        if amount is None:
            delta = 0.0
        elif acc is None:
            delta = amount
        else:
            delta = max(0.0, amount - acc)      # tp_acc accumulates; resets to 0
        acc = amount if acc is None or amount >= acc else amount
        hcode, _ = arso_decode(hrow.get("clouds_icon_wwsyn_icon") or hrow.get("wwsyn_icon"))
        hourly.append((stamp, temp, hcode if hcode is not None else code,
                       round(delta, 1)))

    daily_max = daily_min = None
    for _, drow in _arso_rows(d.get("forecast24h")):
        daily_max, daily_min = _num(drow.get("txsyn")), _num(drow.get("tnsyn"))
        break
    if daily_max is None or daily_min is None:      # hourly-only fallback
        temps = [h[1] for h in hourly]
        daily_max = daily_max if daily_max is not None else (max(temps) if temps else None)
        daily_min = daily_min if daily_min is not None else (min(temps) if temps else None)

    if imperial:
        to_f = lambda c: round(c * 9 / 5 + 32, 1)
        temp_now = to_f(_num(row.get("t"), 0.0))
        temps_h = [(s, to_f(tv), c, p) for s, tv, c, p in hourly]
        dmax, dmin = to_f(daily_max), to_f(daily_min)
    else:
        temp_now = _num(row.get("t"), 0.0)
        temps_h = hourly
        dmax, dmin = daily_max, daily_min

    sr, ss = day.get("sunrise"), day.get("sunset")
    data = {
        "current": {
            "time": _local(row.get("valid"), tz) or datetime.now().strftime("%Y-%m-%dT%H:%M"),
            "temperature_2m": temp_now,
            "apparent_temperature": None,        # ARSO does not publish feels-like
            "relative_humidity_2m": _num(row.get("rh"), 0),
            "weather_code": code,
            "wind_speed_10m": round(wind, 1),
            "wind_direction_10m": arso_direction(row),
            "is_day": 1 if is_day else 0,
            "precipitation": hourly[0][3] if hourly else 0.0,
        },
        "hourly": {
            "time": [h[0] for h in hourly],
            "temperature_2m": [h[1] for h in hourly],
            "weather_code": [h[2] for h in hourly],
            "precip": [h[3] for h in hourly],    # millimetres fallen in that hour
            "precip_kind": "mm",
        },
        "daily": {
            "temperature_2m_max": [dmax] if dmax is not None else [],
            "temperature_2m_min": [dmin] if dmin is not None else [],
            "weather_code": [code],
            "sunrise": [sr] if sr else [],
            "sunset": [ss] if ss else [],
        },
        "latitude": lat, "longitude": lon, "provider": "ARSO",
        "provider_place": title,
    }
    if not hourly:
        raise RuntimeError("ARSO returned no forecast rows")
    return data


def fetch_open_meteo(lat, lon, cfg):
    """Documented global provider; also the fallback when ARSO fails."""
    imperial = cfg["units"] == "imperial"
    params = {
        "latitude": round(lat, 4), "longitude": round(lon, 4),
        "current": "temperature_2m,apparent_temperature,relative_humidity_2m,"
                   "weather_code,wind_speed_10m,wind_direction_10m,is_day,precipitation",
        "hourly": "temperature_2m,weather_code,precipitation_probability",
        "daily": "temperature_2m_max,temperature_2m_min,weather_code,sunrise,sunset",
        # 2 days so the strip still has 12 hours to show late in the evening
        "forecast_days": 2,
        "timezone": "auto",
    }
    if imperial:
        params.update({"temperature_unit": "fahrenheit", "wind_speed_unit": "mph"})
    url = "https://api.open-meteo.com/v1/forecast?" + urllib.parse.urlencode(params)
    data = http_json(url, cfg["timeout"])
    probs = data.get("hourly", {}).get("precipitation_probability")
    if probs is not None:
        data["hourly"]["precip"] = probs
        data["hourly"]["precip_kind"] = "prob"
    data["provider"] = "Open-Meteo"
    return data


def fetch_weather(lat, lon, cfg, place):
    """First provider that answers wins; the rest are fallbacks."""
    wanted = cfg.get("providers") or ["arso", "open-meteo"]
    if isinstance(wanted, str):
        wanted = [wanted]
    errors = {}
    for name in wanted:
        try:
            if name == "arso":
                data = fetch_arso(lat, lon, cfg, place)
            elif name == "open-meteo":
                data = fetch_open_meteo(lat, lon, cfg)
            else:
                raise RuntimeError(f"unknown provider '{name}'")
            if errors:
                log("fell back to {}: {}".format(
                    name, "; ".join(f"{n}: {e}" for n, e in errors.items())))
            return data
        except Exception as exc:
            log(f"provider {name} failed: {exc}")
            errors[name] = exc
    raise WeatherUnavailable(errors)


class WeatherUnavailable(RuntimeError):
    """Every provider failed. .failures maps provider name -> its exception,
    so callers can tell *why* the whole chain died."""

    def __init__(self, failures):
        super().__init__("no weather provider answered ("
                         + "; ".join(f"{n}: {e}" for n, e in failures.items()) + ")")
        self.failures = failures


def _is_dns_error(exc):
    """Whether this exception (or anything wrapped inside it) is a failed
    hostname lookup."""
    seen, stack = set(), [exc]
    while stack:
        e = stack.pop()
        if id(e) in seen:
            continue
        seen.add(id(e))
        if isinstance(e, socket.gaierror):     # urlopen wraps it in URLError.reason
            return True
        for attr in ("reason", "__cause__", "__context__"):
            inner = getattr(e, attr, None)
            if isinstance(inner, BaseException):
                stack.append(inner)
        msg = str(e).lower()
        if ("name or service not known" in msg or "temporary failure in name resolution"
                in msg or "nodename nor servname" in msg or "getaddrinfo" in msg):
            return True
    return False


def is_dns_outage(exc):
    """True when *every* provider failed on a DNS lookup specifically - the
    signature of a machine whose Wi-Fi has not associated yet right after
    login or unlock, rather than of a broken provider or a captive portal."""
    failures = getattr(exc, "failures", None)
    if failures:
        return bool(failures) and all(_is_dns_error(e) for e in failures.values())
    return _is_dns_error(exc)


def fetch_weather_retry(lat, lon, cfg, place):
    """fetch_weather, with a couple of attempts.

    The run that happens right after login regularly wins the race against DNS
    and loses: one failed attempt used to mean a wallpaper showing last night's
    weather for the next quarter of an hour. A plain failure gets a short,
    doubling pause; a pure DNS failure gets dns_retry_wait (a minute), because
    that failure mode means the Wi-Fi association itself is still in progress
    and no shorter wait will change the outcome.
    """
    tries = max(1, int(cfg.get("fetch_retries", 2)) + 1)
    base = max(0, int(cfg.get("fetch_retry_wait", 15)))
    dns_wait = max(0, int(cfg.get("dns_retry_wait", 60)))
    for attempt in range(1, tries + 1):
        try:
            return fetch_weather(lat, lon, cfg, place)
        except Exception as exc:
            if attempt >= tries:
                raise
            if is_dns_outage(exc):
                nap = dns_wait
                why = "DNS not resolving yet (Wi-Fi still connecting?)"
            else:
                nap = base * (2 ** (attempt - 1))
                why = "no provider answered"
            log(f"{why} (attempt {attempt}/{tries}); retrying in {nap}s")
            if nap:
                time.sleep(nap)


# --------------------------------------------------------------- gsettings

def sh(cmd, **kw):
    return subprocess.run(cmd, capture_output=True, text=True, **kw)


def detect_resolution(cfg):
    if cfg.get("resolution"):
        return tuple(int(v) for v in cfg["resolution"].lower().split("x"))
    # Mutter prints the whole display state as a GVariant tuple; mine the mode
    # tuples and keep the ones flagged 'is-current'.
    try:
        out = sh(["gdbus", "call", "--session", "--dest", "org.gnome.Mutter.DisplayConfig",
                  "--object-path", "/org/gnome/Mutter/DisplayConfig",
                  "--method", "org.gnome.Mutter.DisplayConfig.GetCurrentState"]).stdout
        modes = re.findall(
            r"\('\d+x[\d.]+',\s*(\d+),\s*(\d+),\s*[\d.]+,\s*[\d.]+,\s*\[[^\]]*\],\s*\{([^}]*)\}\)",
            out)
        current = [(int(w), int(h)) for w, h, props in modes if "is-current" in props]
        if current:
            return max(current, key=lambda wh: wh[0] * wh[1])
    except Exception as exc:
        log(f"resolution probe failed: {exc}")
    return (1920, 1080)


def dark_mode():
    r = sh(["gsettings", "get", "org.gnome.desktop.interface", "color-scheme"])
    return "dark" in r.stdout


def apply_wallpaper(path):
    """Point GNOME at path. A new path each time is what forces a reload."""
    uri = "file://" + urllib.parse.quote(str(path))
    for key in ("picture-uri", "picture-uri-dark"):
        r = sh(["gsettings", "set", "org.gnome.desktop.background", key, uri])
        if r.returncode:
            raise RuntimeError(f"gsettings set {key} failed: {r.stderr.strip()}")
    sh(["gsettings", "set", "org.gnome.desktop.background", "picture-options", "scaled"])


def prune(keep):
    files = sorted(DATA_DIR.glob("wx-*.png"))
    for old in files[:-keep] if keep > 0 else files:
        try:
            old.unlink()
        except OSError:
            pass


